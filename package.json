{
  "name": "holameet",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "docker compose up -d && concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "lint": "eslint .",
    "format": "prettier --check .",
    "migrate:up": "npm run migrate:up -w backend",
    "migrate:down": "npm run migrate:down -w backend",
    "test": "npm run test -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22"
  }
}
